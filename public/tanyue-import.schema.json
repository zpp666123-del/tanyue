{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanyue.local/schemas/import-package-v1.json",
  "title": "弹阅 Agent 导入包 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "offsetUnit", "book", "source", "processing", "blocks", "segments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "offsetUnit": { "const": "unicode-scalar" },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "author": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "format"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "format": { "enum": ["txt", "md", "url", "pdf", "docx", "epub", "json"] },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parser", "segmenter"],
      "properties": {
        "parser": { "$ref": "#/$defs/versionedProcessor" },
        "segmenter": { "$ref": "#/$defs/segmenterProcessor" }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sequence", "type", "text", "sourceAnchor"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sequence": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["heading", "paragraph", "list"] },
          "text": { "type": "string", "minLength": 1 },
          "sourceAnchor": { "$ref": "#/$defs/sourceAnchor" }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "spans"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "chapterTitle": { "type": "string", "minLength": 1, "maxLength": 300 },
          "spans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["blockId", "start", "end"],
              "properties": {
                "blockId": { "type": "string", "minLength": 1, "maxLength": 200 },
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "versionedProcessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "segmenterProcessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "ruleVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ruleVersion": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "sourceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "label"],
      "properties": {
        "kind": { "enum": ["chapter", "line", "page", "cfi", "url"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "label": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
